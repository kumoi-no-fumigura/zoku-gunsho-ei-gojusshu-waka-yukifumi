 "poems": [
  {
   "seq": "1",
   "text": "青といへとまつくむけふのわか水やおひをぬ君かためしなるらん",
   "kana": "",
   "speaker": "大膳権大夫行文",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "橋たてや中空かけてかすむらしよさのふけゐの春のあけほの",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "はるならてたれかはとはむ我やとにはやあと見ゆる庭のしら雪",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "いつる日も長閑き春のあさもよひ木々のこすゑに鴬そなく",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "難波かたおして日月もむかしにてありしみやこの梅匂ふなり",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "暮るまてわくるやま路のさてはり月こそ花のしほりなりけれ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "山さくらいまさてししかのあまのつりする袖も匂にはる風",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "雪とたにつもるもやらてちかる花の行衛さためぬ山風そふく",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "ならひにもさのゝはいかゝ果すまゝし物ひはまたきの春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "わたつ海のかさしとみへて浪かるたこの浦藤いまさより那案",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "日数たにうつらさり世ははなころもかふるならひもしられさるまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "ほとゝきす侍夜のかすやつもるらむうつゝときけはまとつみわり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "すみよしや岸田のさなへとりそめぬゆきあひのわせの秋をもつとて",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "かくてなを平をてらさぬやあつめえぬ窓の蛍の思ひなるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "うかひ舟いまや早瀬をくたるら舞とをさかり行かたり火のかけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "さと人は見そきしぬらしみなせ川あさの末葉もありてゆくなり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏六首",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "ゆふつく日うつろふ雲のいろまてもいとはれてうき秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "星合のあまのたなはし秋かけて契も空にとまへやはせぬ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "吹すてゝすきゆく風のあとになをころとそよく庭の萩はら",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "いかにせん身にはかきらぬあはれともなくさめかぬる秋のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "いく秋かちきらぬつまをおもひいつるときはの山に床のなへらむ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "ふけぬるか月は夜寒の妹かせに雲もまとをの衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "うす霧のまかきの嶋もへたてなく月のかけみつしほかまのうら",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "ふか草やさとは野となる秋か姿にたれすみなれて衣うつ罷舞",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "ゆめ残す梢もあらしやま姫の時雨に袖をかしつきのもり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "行秋のとまらすとてもこむとしのけふのゆふへとちきりをかなん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "秋の色をそめし名残もいま見えて庭の木葉をうつむ霜かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "山かけの吹まく四方のこの葉さへしくれて月のくまと見へつゝ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "いまもなをつかへし世々の跡こめてみかきの雪をふみわくる哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "つもりそふ雪こそけさは見ゆの山なひく檜原のかさし折なれ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "河風に八十うち人の袖さえて月を友とやあしろもるらむ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "こむ春をいそくいよ永につもるならひもしらぬ年のくれかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "はてしなき恋のたゝちよいつしかとなにをしるへにふてまよはまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "しらせはやうへにはしけるうき草の下にねをたえおもひわふとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "見なの川をとにきゝつゝつくはねのみねとも袖に浪はかゝりき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "後の世と契りをかはそこひしな舞あふにはかへぬ命なりとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "つゐにさてあかぬいのちの露ときえは草のかけにや人をうらみ舞",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "神もゝしまさにかゝにやなひくらんいのるによらぬ中のちきりは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "したにのみおもひみたれてかくとたにえこそいはねの滝の白糸",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "みや木ひくみほの杣人なれよりもくるしき物をかみたつ名は",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "いまははやからみし比を身のほとのあるになしてや思ひいてまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "はし鷹のとやのゝすえのまくすはらうらみつこひつ世をつくす哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "きゝそむるゆふつけ鳥のひとこへにいく里人の寝覚しぬらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "いかて猶おくへし庭の松か枝にかはらぬ家の風をのこさん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "暮にけり日影は嶺におちこちのさとのつゝきの入桐のかね",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "山布かさ草の戸さしのかりのいほ果り初にたに人はとひこす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "わかの浦のちりにつけとやかきをかむかひも波間のもくつなれとも",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "浮世とていとひし人やいとはぬをはかなき物と余所にみるら舞",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "つこや山千とせのさかもいくたひかいま君か代にこえんとすら舞",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "ます鏡あまてらす神の宮井をもうつかしかふへき時はきにけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑八首",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "長閑なる日の川上のあまかすみ神代にかへるけふのはなかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "あさ風もはやさむからてうちふやま霞の衣魚かさねつゝ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "一春をへて花になくなる鴬は色香にのみや心そむらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "さそひくるあらしのよはるほとなれや枕にうすき夜はの梅香",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "〽いかねむ我世如郎気ゆくなみたにもさなからかすむ春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "花のめにさへつる鳥もめる物を見すてゝなとか雁の行らむ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "さきやらぬ花のためとやいそくよむしよふならひの春の日数を",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "これも又花のかゝみややまさくら咲るおのへをいつる月影",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "一瀧津をやなかなるよとに七か花もなかれてはやき春風そ吹",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "花鳥の名残を跡にのこしをきていつへにけふは春の行らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春十首",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "夏ころも袖にそあらぬいつならめ心は花に猶やそめまし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏五首",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "今夜しもなをつれなくてむり雨の空たのめなるほとゝさすぐう",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏五首",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "さりてたに月はよ所なる谷かけの夜な〳〵くらき五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏五首",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "草かくれあさく八水にとふほたるたま〳〵見ゆるかけたにもなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏五首",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "さとはあれて松布く風のまつ人もあらぬ物から跡はきにけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "秋毎にけふかやいとのふして思ひをきてやまちし星合の空",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "萩の葉の露ふきすつる風ならはぬるゝ袖ほすゆふくれもかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "たちくもる遠の山もといつくともえこそ見なせの秋の河霧",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "秋風におのへの霧のたちわかれいなはの山をいつる月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "時しあれはあらたまるへき神垣にかはらぬ物と月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "つくはねの嶺行雁も声おちてこのもかのもに月そ残れる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "いり日さにいな葉の雲を色かへて夕さひしき小田のかりいほ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "さたかには音もきこえすさ夜ころもふけてやしはし打たゆむ説",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "もみち葉もそろきあらしの山かのちおのへの秋やくれかゝるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋十首",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "夢さむるまくらの時雨冬きぬとおとろかしてや余所に過らん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬五首",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "答ふかみ人目もつれて枯にけりとはれぬ道の霜のした草",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬五首",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "大井河瀬々になかるゝ木葉こそ山の嵐の行ゑなりけれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬五首",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "あつむとも世にしられしな数ならぬみやまかくれの窓の出雪",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬五首",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "〽かくはかりつもるはやすきとしほみの跡なき雪にいつならひけん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬五首",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "下にのみおもひ見たれてかくとしにえにえにそいはねの滝のしらいと",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "さらは又たのめぬ暮やたのまましかくいつはりのある世なりせは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "我中はありしにもあらぬゆふ暮をむかしになして秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "つれなさき父のも見えていたつらに名は和り残るあふの松原",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "月見すはよも時れしとこよひさへなを身のほとをまつかこめつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "神多にもけたぬおもひのけふりこそうへなきふしの名には立らめ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "かへしてもつゐにねられぬ小夜衣夢の契もまとをなりけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "よしさらはそにもしつめ布世の海や恨ありそのかひもなき身は",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "せめてけになくさむかたと思ひねの夢路はかりやちきりなるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "あはぬにもまさりてつらきならはしのありける物を人のわかれも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋十首",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "松になを音を残しておきつなみたかしの浜は秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "くれ竹はゆかりにあらぬ色なから千代のかけそふ此糸のには",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "てらさすは身をいかにせんかゝ気てもわか世ふけゆく窓の燈火",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "あしやかたなれぬうきねの浪枕我すむかたの夢もゆるさす",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "やとなくはよしやい心のゝ小篠はらかりねの月を身枕に安ん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "世の行忠さてもうつゝに何をして骨はかりを夢とおもはむ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "露霜のあかつき起もいくたひか神わさしけき身にならふめ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "名草山みねなる月のかけよりも御影も高き日前の神",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "あし原の世々のことの葉すゑつねにたえぬ道とやさかえ行覧",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-4395151",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首",
   "kotobagaki": ""
  }
 ],
